// prisma/schema.prisma — shared at root (monorepo)
// Generates clients for both frontend and backend workspaces.

generator client {
  provider = "prisma-client-js"
}

generator backendClient {
  provider = "prisma-client-js"
  output   = "../backend/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Category {
  RESEARCH
  SEMINAR
  PROJECT
  ANALYSIS
}

enum NotificationType {
  COMMENT
  LIKE
  MESSAGE
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MODERATION
  MENTORSHIP_REQUEST
  MENTORSHIP_ACCEPTED
  MENTOR_PROFILE_APPROVED
  MENTOR_PROFILE_REJECTED
  INTERNSHIP_ACCEPTED
  INTERNSHIP_REJECTED
}

enum MentorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  DEACTIVATED
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  ENDED
  DECLINED
}

enum InternshipStatus {
  OPEN
  CLOSED
  FILLED
}

enum InternshipType {
  REMOTE
  ONSITE
  HYBRID
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REMOVED
}

enum DocumentStatus {
  PUBLISHED
  HIDDEN
}

enum Resolution {
  NONE
  DELETED
  HIDDEN
  WARNED
  SUSPENDED
  DISMISSED
}

enum ReportReason {
  PLAGIARISM
  MISLEADING
  COPYRIGHT
  INAPPROPRIATE
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String         @id @default(cuid())
  name              String?
  email             String         @unique
  image             String?
  password          String?
  emailVerified     DateTime?
  verificationCode  String?
  codeExpiry        DateTime?
  lastCodeRequestAt DateTime?
  passwordResetTokenHash      String?
  passwordResetExpiry         DateTime?
  lastPasswordResetRequestAt  DateTime?
  Profile           Profile[]
  Document          Document[]
  conversationsA    Conversation[] @relation("participantA")
  conversationsB    Conversation[] @relation("participantB")
  readReceipts      ReadReceipt[]
  notifications     Notification[]
  likes             Like[]
  comments          Comment[]
  saves             Save[]
  downloadRecords   DownloadRecord[]
  reviews           Review[]
  reports           Report[]
  profileVisitsReceived ProfileVisit[] @relation("profileVisitsReceived")
  ownedCommunities  Community[]      @relation("communityOwner")
  communityMemberships CommunityMember[]
  connectionsA      Connection[]     @relation("connectionA")
  connectionsB      Connection[]     @relation("connectionB")
  resolvedReports   Report[]         @relation("reportResolver")
  adminActions      AdminAction[]
  allowMessages     Boolean          @default(true)
  showInSearch      Boolean          @default(true)
  role              Role             @default(USER)
  isSuspended       Boolean          @default(false)
  suspendedAt       DateTime?
  suspendedReason   String?
  mentorProfile     MentorProfile?
  mentorshipsRequestsSent    MentorshipRequest[] @relation("mentorshipRequester")
  mentorshipsRequestsReceived MentorshipRequest[] @relation("mentorshipMentor")
  mentorshipsAsMentor        Mentorship[]        @relation("mentorshipMentorActive")
  mentorshipsAsMentee        Mentorship[]        @relation("mentorshipMentee")
  mentorshipsReviewed        MentorshipReview[]  @relation("mentorshipReviewer")
  internshipsPosted          Internship[]
  internshipApplications     InternshipApplication[]
}

model ProfileVisit {
  id             String   @id @default(cuid())
  profileOwner   User     @relation("profileVisitsReceived", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  profileOwnerId String  
  visitorId      String? 
  createdAt      DateTime @default(now())

  @@index([profileOwnerId, createdAt])
}

model Profile {
  id          String   @id @default(cuid())
  institution String
  department  String
  aboutMe     String
  state       String
  country     String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id              String           @id @default(cuid())
  title           String
  description     String
  category        Category
  institution     String
  year            String
  fileUrl         String
  fileKey         String
  fileName        String
  fileSize        Int
  downloads       Int              @default(0)
  likes           Int              @default(0)
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String          
  status          DocumentStatus   @default(PUBLISHED)
  hiddenAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  likeRecords     Like[]
  commentRecords  Comment[]
  saveRecords     Save[]
  downloadRecords DownloadRecord[]
  reviewRecords   Review[]
  reportRecords   Report[]
  communityLinks  DocumentCommunity[]
}

model Notification {
  id         String           @id @default(cuid())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String          
  type       NotificationType
  message    String
  actorId    String?         
  documentId String?         
  link       String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
}

model Like {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String  
  createdAt  DateTime @default(now())

  @@unique([userId, documentId])
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String  
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

model Save {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String  
  createdAt  DateTime @default(now())

  @@unique([userId, documentId])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String  
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, documentId])
  @@index([documentId])
}

model Report {
  id            String         @id @default(cuid())
  reason        String
  description   String?
  status        ReportStatus   @default(PENDING)
  resolution    Resolution     @default(NONE)
  resolvedAt    DateTime?
  resolver      User?          @relation("reportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById  String?
  reporter      User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId    String        
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    String        
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([reporterId, documentId])
  @@index([documentId])
  @@index([resolvedById])
}

model AdminAction {
  id         String   @id @default(cuid())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId    String
  action     String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model DownloadRecord {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String  
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Conversation {
  id             String        @id @default(cuid())
  participantA   User          @relation("participantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantAId String       
  participantB   User          @relation("participantB", fields: [participantBId], references: [id], onDelete: Cascade)
  participantBId String       
  createdAt      DateTime      @default(now())
  messages       Message[]
  readReceipts   ReadReceipt[]

  @@unique([participantAId, participantBId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String      
  senderId       String      
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ReadReceipt {
  id                String       @id @default(cuid())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId    String      
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String      
  lastReadMessageId String      
  readAt            DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Community {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  image       String?
  owner       User     @relation("communityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  members     CommunityMember[]
  documents   DocumentCommunity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

model CommunityMember {
  id          String    @id @default(cuid())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

model DocumentCommunity {
  id          String    @id @default(cuid())
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  createdAt   DateTime  @default(now())

  @@unique([documentId, communityId])
  @@index([communityId])
}

model Connection {
  id          String           @id @default(cuid())
  userAId     String
  userBId     String
  requesterId String
  status      ConnectionStatus @default(PENDING)
  userA       User             @relation("connectionA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User             @relation("connectionB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userAId, userBId])
  @@index([requesterId])
  @@index([userBId, status])
}

// ─── Mentorship ──────────────────────────────────────────────────────────
// A MentorProfile is the "who is a mentor" record. Being a mentor means a
// user holds an APPROVED profile (admins review applications). It is a
// capability, not a Role — Role stays USER/ADMIN for access control.
model MentorProfile {
  id              String              @id @default(cuid())
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String              @unique
  title           String              // e.g. "Senior Lecturer", "Software Engineer"
  bio             String              @default("")
  areas           String              @default("") // JSON array of strings
  yearsExperience Int                 @default(0)
  availability    String              @default("") // e.g. "2 hrs/week", "Weekends"
  status          MentorApprovalStatus @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
}

// A mentorship request: a mentee asks an approved mentor to take them on.
model MentorshipRequest {
  id          String           @id @default(cuid())
  mentor      User             @relation("mentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId    String
  requester   User             @relation("mentorshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  topic       String           @default("") // area they want mentoring in
  message     String           @default("")
  status      MentorshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([mentorId, requesterId])
  @@index([mentorId, status])
  @@index([requesterId])
}

// An active/ended mentoring relationship.
model Mentorship {
  id          String           @id @default(cuid())
  mentor      User             @relation("mentorshipMentorActive", fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId    String
  mentee      User             @relation("mentorshipMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  menteeId    String
  status      MentorshipStatus @default(ACTIVE)
  topic       String           @default("")
  startedAt   DateTime         @default(now())
  endedAt     DateTime?
  reviews     MentorshipReview[]

  @@index([mentorId])
  @@index([menteeId])
}

model MentorshipReview {
  id            String     @id @default(cuid())
  mentorship    Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  mentorshipId  String
  reviewer      User       @relation("mentorshipReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId    String
  rating        Int        // 1-5
  content       String     @default("")
  createdAt     DateTime   @default(now())

  @@unique([mentorshipId, reviewerId])
  @@index([mentorshipId])
}

// ─── Internships ─────────────────────────────────────────────────────────
model Internship {
  id                   String                @id @default(cuid())
  title                String
  company              String
  description          String
  type                 InternshipType        @default(ONSITE)
  location             String                @default("")
  duration             String                @default("") // e.g. "3 months"
  stipend              String                @default("") // free text: "Paid" / "KES 20,000/mo"
  applicationDeadline  DateTime?
  postedBy             User                  @relation(fields: [postedById], references: [id], onDelete: Cascade)
  postedById           String
  status               InternshipStatus      @default(OPEN)
  hidden               Boolean               @default(false)
  hiddenAt             DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  applications         InternshipApplication[]

  @@index([postedById])
  @@index([status])
  @@index([createdAt])
}

model InternshipApplication {
  id           String            @id @default(cuid())
  internship   Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  internshipId String
  applicant    User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId  String
  coverLetter  String
  resumeUrl    String?
  resumeName   String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([internshipId, applicantId])
  @@index([internshipId])
  @@index([applicantId])
}
